<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Static rules wiki — do not fall through to the React app.
  RewriteRule ^rules/?$ /rules/intro.html [R=302,L]
  RewriteRule ^rules/ - [L]

  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # HTML entry points — revalidate so new script/style URLs are picked up.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # Vite bundles — filenames include content hashes.
  <LocationMatch "^/assets/">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </LocationMatch>

  # Rules wiki static bundles — unhashed filenames, revalidate each visit.
  <LocationMatch "^/rules/.*\.(js|css)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </LocationMatch>
</IfModule>
