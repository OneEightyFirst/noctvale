# Copy to .env.local and fill in your values. Never commit .env.local.

# Namecheap deploy (Duck CLI + Keychain — no password in this file)
FTP_HOST=your-server.web-hosting.com
FTP_USER=your_cpanel_username
FTP_REMOTE_DIR=/public_html/your-app-folder

# Firebase web app config (Firebase Console → Project settings → Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
